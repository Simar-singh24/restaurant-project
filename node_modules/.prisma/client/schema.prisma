generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model MenuItem {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       String
  image       String
  rating      Float
  trending    Boolean
}

model Cocktail {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       String
  image       String
  isSpecial   Boolean
}
